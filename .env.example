# ===== 模型：默认 DeepSeek（国内直连、便宜、OpenAI 兼容）=====
DEEPSEEK_API_KEY=<你的-deepseek-api-key>

# 可按角色覆盖模型规格，格式 "provider:model"。不填则全部用 deepseek-chat。
# MODEL_PLANNER=deepseek:deepseek-chat
# MODEL_RESEARCHER=deepseek:deepseek-chat
# MODEL_SYNTHESIZER=deepseek:deepseek-chat
# MODEL_CRITIC=deepseek:deepseek-chat
# MODEL_JUDGE=deepseek:deepseek-chat
# MODEL_VERIFIER=deepseek:deepseek-chat

# 若切换 OpenAI / Qwen / GLM / Kimi，在这里填对应 key，并把 MODEL_* 改成对应 provider。
# OPENAI_API_KEY=<your-openai-api-key-here>

# ===== 联网搜索 =====
TAVILY_API_KEY=<your-tavily-api-key-here>
# auto: Tavily 失败时自动切 Bing RSS；也可显式设为 tavily / bing
# SEARCH_PROVIDER=auto
# SEARCH_MAX_RESULTS=6
# SEARCH_TIMEOUT_SECONDS=10

# ===== 护栏与预算（可选，默认值在 config.py 里）=====
# GUARDRAIL_INPUT_ENABLED=true
# GUARDRAIL_OUTPUT_ENABLED=true
# MAX_RESEARCH_ITERATIONS=2
# MAX_LLM_CALLS_PER_RUN=60
# BUDGET_RESERVE_FOR_SYNTHESIS=6
# MIN_CITATION_COVERAGE=0.8
# MAX_OUTPUT_REPAIRS=1
# RETRY_MAX_ATTEMPTS=4

# Claim-Evidence 事实核验
# ENABLE_VERIFIER=true
# VERIFIER_MAX_CLAIMS=8
# VERIFIER_MAX_EVIDENCE=5

# ===== 评测门槛（M8）=====
# EVAL_MIN_FAITHFULNESS=0.7
# EVAL_MIN_COVERAGE=0.6
# EVAL_MIN_CITATION_ACCURACY=0.8
# EVAL_MAX_CASES=0

# ===== 持久化与人在回路 =====
# CHECKPOINT_DB_PATH=checkpoints.db
# HITL_APPROVAL_ENABLED=false

# ===== 可观测（可选，LangSmith）=====
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=<your-langsmith-api-key-here>
# LANGSMITH_PROJECT=deep-research-agent
